# ============================================
# Devotion Global CSP - Hong Kong .htaccess
# ============================================

RewriteEngine On

# --------------------------------------------
# 1. Force HTTPS
# --------------------------------------------
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --------------------------------------------
# 2. Force non-www
# --------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# --------------------------------------------
# 3. Don't rewrite existing files/folders
# --------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --------------------------------------------
# 4. Clean URL Routes
# --------------------------------------------

# Corporate Structure
RewriteRule ^corporate-structure/?$ corporate-structure.php [L,QSA]
RewriteRule ^corporate-structure/([^/]+)/?$ corporate-structure.php?slug=$1 [L,QSA]

# Manufacturing
RewriteRule ^manufacturing/?$ manufacturing.php [L,QSA]
RewriteRule ^manufacturing/([^/]+)/?$ manufacturing.php?slug=$1 [L,QSA]

# Financial Services
RewriteRule ^financial-services/?$ financial-services.php [L,QSA]
RewriteRule ^financial-services/([^/]+)/?$ financial-services.php?slug=$1 [L,QSA]

# Book Keeping
RewriteRule ^book-keeping/?$ book-keeping.php [L,QSA]
RewriteRule ^book-keeping/([^/]+)/?$ book-keeping.php?slug=$1 [L,QSA]

# Business Setup
RewriteRule ^business-setup/?$ business-setup.php [L,QSA]
RewriteRule ^business-setup/([^/]+)/?$ business-setup.php?slug=$1 [L,QSA]

# Cash Flow
RewriteRule ^cash-flow/?$ cash-flow.php [L,QSA]
RewriteRule ^cash-flow/([^/]+)/?$ cash-flow.php?slug=$1 [L,QSA]

# --------------------------------------------
# 5. Custom 404
# --------------------------------------------
ErrorDocument 404 /404.php

# --------------------------------------------
# 6. Compression
# --------------------------------------------
<IfModule mod_deflate.c>

    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml

</IfModule>

# --------------------------------------------
# 7. Browser Cache
# --------------------------------------------
<IfModule mod_expires.c>

    ExpiresActive On

    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    ExpiresByType application/pdf "access plus 1 month"

    ExpiresByType text/html "access plus 0 seconds"

</IfModule>

# --------------------------------------------
# 8. Cache Headers
# --------------------------------------------
<IfModule mod_headers.c>

    <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff|woff2|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

</IfModule>

# --------------------------------------------
# 9. Security Headers
# --------------------------------------------
<IfModule mod_headers.c>

    Header always set X-Content-Type-Options "nosniff"

    Header always set Strict-Transport-Security \
        "max-age=31536000; includeSubDomains; preload" env=HTTPS

    Header always set X-Frame-Options "SAMEORIGIN"

    Header always set Referrer-Policy \
        "strict-origin-when-cross-origin"

    Header always set Permissions-Policy \
        "geolocation=(), microphone=(), camera=()"

</IfModule>

# --------------------------------------------
# 10. Block Sensitive Files
# --------------------------------------------

<Files "contact.txt">
    Require all denied
</Files>

<Files "appointment.txt">
    Require all denied
</Files>

<Files "function.php">
    Require all denied
</Files>

# --------------------------------------------
# 11. Disable Directory Listing
# --------------------------------------------

Options -Indexes